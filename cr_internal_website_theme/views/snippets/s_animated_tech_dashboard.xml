<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template 1: Animated Tech Dashboard Hero (Original) -->
    <template id="s_animated_tech_dashboard" name="Animated Tech Dashboard Hero">
        <section class="s_animated_tech_dashboard cr_font py-5" data-snippet="s_animated_tech_dashboard" data-name="Animated Tech Dashboard Hero">
            <!-- Background Grid & Connecting Lines -->
            <div class="tech-grid-bg">
                <svg class="connecting-grid-lines" viewBox="0 0 1440 800" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                    <!-- Dashed horizontal and vertical lines with modern glowing path transitions -->
                    <path class="grid-line line-h-1" d="M100,200 L1340,200" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="4 4" />
                    <path class="grid-line line-h-2" d="M100,500 L1340,500" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="4 4" />
                    <path class="grid-line line-v-1" d="M300,100 L300,700" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="4 4" />
                    <path class="grid-line line-v-2" d="M1140,100 L1140,700" stroke="#e2e8f0" stroke-width="1.5" stroke-dasharray="4 4" />
                    
                    <!-- Data flows (glowing animations) -->
                    <path class="flow-path flow-1" d="M300,200 L720,200 L720,500" stroke="url(#flow-gradient-blue)" stroke-width="2" />
                    <path class="flow-path flow-2" d="M1140,200 L720,200 L720,500" stroke="url(#flow-gradient-green)" stroke-width="2" />
                    
                    <defs>
                        <linearGradient id="flow-gradient-blue" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0" />
                            <stop offset="50%" stop-color="#3b82f6" stop-opacity="1" />
                            <stop offset="100%" stop-color="#6366f1" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="flow-gradient-green" x1="100%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#10b981" stop-opacity="0" />
                            <stop offset="50%" stop-color="#10b981" stop-opacity="1" />
                            <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>

            <div class="container tech-hero-content text-center mb-5" data-aos="fade-up">
                <span class="badge rounded-pill bg-light text-primary px-3 py-2 mb-3 border border-primary-light font-weight-bold">
                    LEADING ODOO ERP IMPLEMENTATION
                </span>
                <h1 class="hero-title mb-3">
                    Trusted <span class="highlight-word">Enterprise Automation</span> Solution
                </h1>
                <p class="hero-subtitle text-muted mx-auto mb-4" style="max-width: 650px;">
                    Creyox automates core business operations, integrates custom module logic, and builds high-performance ERP systems designed to scale with your enterprise.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/contactus" class="btn btn-primary btn-lg px-4 py-3 rounded-pill shadow-sm font-weight-bold">
                        Get Started
                    </a>
                    <a href="/helpdesk" class="btn btn-outline-secondary btn-lg px-4 py-3 rounded-pill font-weight-bold">
                        View Live Demo
                    </a>
                </div>
            </div>

            <!-- Interactive UI Cards Grid -->
            <div class="container position-relative z-index-2">
                <div class="row align-items-center justify-content-center mt-5">
                    
                    <!-- Left Column Card (Manual vs Odoo Toggle) -->
                    <div class="col-lg-3 col-md-5 mb-4" data-aos="fade-right" data-aos-delay="100">
                        <div class="tech-card tech-card-toggle p-4">
                            <div class="card-header-simple mb-3">
                                <span class="card-category">PERFORMANCE</span>
                                <h5 class="card-title-sm mb-0">System Efficiency</h5>
                            </div>
                            
                            <!-- Toggle Item 1 -->
                            <div class="toggle-row d-flex align-items-center justify-content-between mb-3 py-2 border-bottom border-light">
                                <div class="toggle-text">
                                    <div class="toggle-name text-muted">Without Odoo</div>
                                    <div class="toggle-stat font-weight-bold text-danger">15% Efficiency</div>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" disabled="disabled" />
                                </div>
                            </div>

                            <!-- Toggle Item 2 -->
                            <div class="toggle-row d-flex align-items-center justify-content-between py-2">
                                <div class="toggle-text">
                                    <div class="toggle-name text-muted">With Creyox Odoo</div>
                                    <div class="toggle-stat font-weight-bold text-success">95% Efficiency</div>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" checked="checked" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Center Integration & Connection Diagram -->
                    <div class="col-lg-6 col-md-10 text-center mb-4" data-aos="zoom-in" data-aos-delay="200">
                        <div class="tech-center-diagram p-4">
                            <div class="diagram-title-label mb-4 text-uppercase">Central Odoo Connection Hub</div>
                            
                            <div class="diagram-flow-container">
                                <!-- Left side connected apps -->
                                <div class="diagram-left-apps">
                                    <div class="app-icon-bubble" title="Shopify">
                                        <i class="fab fa-shopify text-success"></i>
                                    </div>
                                    <div class="app-icon-bubble" title="PostgreSQL">
                                        <i class="fas fa-database text-info"></i>
                                    </div>
                                    <div class="app-icon-bubble" title="Stripe">
                                        <i class="fab fa-cc-stripe text-primary"></i>
                                    </div>
                                </div>

                                <!-- Center Pill -->
                                <div class="diagram-center-pill">
                                    <span class="center-pill-text">CREYOX CORE</span>
                                    <div class="pulse-ring"></div>
                                </div>

                                <!-- Right side connected apps -->
                                <div class="diagram-right-apps">
                                    <div class="app-icon-bubble" title="Sales">
                                        <i class="fas fa-chart-line text-warning"></i>
                                    </div>
                                    <div class="app-icon-bubble" title="Inventory">
                                        <i class="fas fa-boxes text-danger"></i>
                                    </div>
                                    <div class="app-icon-bubble" title="Accounting">
                                        <i class="fas fa-calculator text-success"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column Card (Secure Protection) -->
                    <div class="col-lg-3 col-md-5 mb-4" data-aos="fade-left" data-aos-delay="100">
                        <div class="tech-card tech-card-security p-4">
                            <div class="card-header-simple mb-3">
                                <span class="card-category">SECURITY</span>
                                <h5 class="card-title-sm mb-0">Proxy Protection</h5>
                            </div>
                            
                            <div class="text-center my-3 position-relative">
                                <div class="shield-icon-container">
                                    <i class="fas fa-shield-halved text-success"></i>
                                </div>
                                <div class="shield-pulse-bg"></div>
                            </div>

                            <div class="security-list mt-3">
                                <div class="security-item d-flex align-items-center gap-2 mb-2 text-muted">
                                    <i class="fas fa-check-circle text-success"></i>
                                    <span>Secured Proxy Protection</span>
                                </div>
                                <div class="security-item d-flex align-items-center gap-2 text-muted">
                                    <i class="fas fa-check-circle text-success"></i>
                                    <span>Automated Failover</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>
    </template>

