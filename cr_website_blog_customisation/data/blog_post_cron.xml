<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_blog_post_schemas" model="ir.cron">
            <field name="name">Blog Post: Generate Default Schemas (Once)</field>
            <field name="model_id" ref="website_blog.model_blog_post"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_default_schema()</field>
            <field name="user_id" ref="base.user_root"/>
